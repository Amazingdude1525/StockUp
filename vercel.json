{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/stockup",
      "destination": "/api/stockup"
    },
    {
      "source": "/api/razorpay",
      "destination": "/api/razorpay"
    },
    {
      "source": "/((?!_next/|_vinext/|stockup-|favicon|.*\\..*).*)",
      "destination": "/api/index"
    }
  ]
}
